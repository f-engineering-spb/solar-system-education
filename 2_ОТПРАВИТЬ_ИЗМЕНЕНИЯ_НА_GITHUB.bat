@echo off
chcp 65001 >nul
color 0B
title 🚀 Отправка изменений в Solar System Education

cd /d "%~dp0"
echo ================================================================
echo        🚀 ОТПРАВКА ИЗМЕНЕНИЙ НА GITHUB
echo ================================================================
echo.

echo 1. Получение последних обновлений из репозитория...
git pull --rebase origin main

echo.
echo 2. Измененные файлы:
git status -s

echo.
set /p msg="Введите кратко, что вы сделали (или просто нажмите Enter): "
if "%msg%"=="" set msg=Обновление 3D-планетария

git add .
git commit -m "%msg%"
echo.
echo 3. Отправка на GitHub...
git push origin main

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ================================================================
    echo   ✅ Все изменения успешно отправлены на GitHub!
    echo ================================================================
) else (
    echo.
    echo ================================================================
    echo   ⚠️ Если открылось окно браузера, подтвердите вход в GitHub.
    echo ================================================================
)
echo.
pause
